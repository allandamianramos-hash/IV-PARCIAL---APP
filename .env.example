LIGHTNING_API_KEY=replace_with_your_lightning_key
RUMBITO_MODEL=openai/gpt-5-mini
# Production: set the exact HTTPS origin of the website.
# APP_ORIGIN=https://your-domain.example
# Alojamiento Node: NODE_ENV=production; HOST=0.0.0.0.
# PORT lo asigna el alojamiento. En desarrollo se conserva 127.0.0.1:3000.
# Google ya está configurado en config/oauth-public.json para todo el equipo.
# Solo para usar otra aplicación OAuth: GOOGLE_CLIENT_ID=su_id_publico
# PHP en producción: origen HTTPS exacto. En localhost, dejar sin definir.
# PHP_APP_ORIGIN=https://your-domain.example

# SQL Server: activar después de configurar y aplicar migraciones
DB_ENABLED=true
# Base compartida: usar check para que los compañeros solo comprueben la conexión.
# DB_SETUP_MODE=check
DB_SERVER=localhost
DB_NAME=BD_VIAJES
DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Solo desarrollo local con certificado autofirmado
DB_TRUST_CERTIFICATE=true
# Para DB_AUTH=sql, completar localmente:
# DB_USER=rumbo_app
# DB_PASSWORD=
# DB_PORT=1433

# Microsoft ya está configurado en config/oauth-public.json para todo el equipo.
# Solo para usar otra aplicación Entra: MICROSOFT_CLIENT_ID=su_id_publico

# Recuperación por correo. Solo en el servidor; nunca publicar estas credenciales.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Rumbo
# Generar una clave independiente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MAIL_RESET_SECRET=
