# Copiar valores a .env en la RAIZ. Sustituir los tres datos indicados.
# No enviar contrasenas en Git ni en el ZIP.
DB_ENABLED=true
DB_SETUP_MODE=check
DB_SERVER=CAMBIAR_SERVIDOR.database.windows.net
DB_PORT=1433
DB_NAME=BD_VIAJES
DB_AUTH=sql
DB_USER=CAMBIAR_USUARIO
DB_PASSWORD="CAMBIAR_CONTRASENA"
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERTIFICATE=false
# PHP_APP_ORIGIN se deja SIN definir para usar localhost:8000 o Live Server:5500.
# ID público del cliente OAuth web. Autorizar el puerto exacto en Google Cloud.
GOOGLE_CLIENT_ID=

# ID público de la aplicación Microsoft Entra (SPA; sin secreto).
MICROSOFT_CLIENT_ID=

# Recuperación por correo. Solo en el servidor; nunca publicar estas credenciales.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Rumbo
# Generar una clave independiente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MAIL_RESET_SECRET=
