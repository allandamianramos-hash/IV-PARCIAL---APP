{
  "name": "rumbo-viajes",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "node server.mjs",
    "open": "node server.mjs --open",
    "build": "tsc --noEmit && vite build && npm run build:auth && npm run build:seo",
    "dev:hero": "vite build --watch",
    "test": "node --test tests/*.test.mjs",
    "db:check": "node database/manage.mjs check",
    "db:migrate": "node database/manage.mjs migrate",
    "db:seed": "node database/manage.mjs seed",
    "db:test": "node --test tests/integration/database.test.mjs tests/integration/auth.test.mjs",
    "php:test": "node --test tests/integration/php.test.mjs",
    "db:export": "node database/export-installer.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:reviews": "node --test tests/integration/reviews.test.mjs",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "chat:check": "node scripts/diagnostico-rumbito.mjs",
    "build:auth": "node scripts/build-auth.mjs",
    "build:seo": "node scripts/build-seo.mjs",
    "test:checkout": "node --test tests/integration/checkout.test.mjs",
    "test:load": "node scripts/load-test.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "msnodesqlv8": "^5.5.0",
    "mssql": "^12.7.2",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
